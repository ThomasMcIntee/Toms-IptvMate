<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/black">

    <!--
      Must NOT be named exo_player_view.xml. PlayerView inflates that layout name
      as its internals; a PlayerView root there recursively constructs forever
      and ANRs Fire TV on the main thread.
    -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/native_exo_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:keep_content_on_player_reset="true"
        app:shutter_background_color="@android:color/black"
        app:surface_type="surface_view"
        app:use_controller="false" />
</FrameLayout>
