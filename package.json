{
  "name": "toms-iptvmate",
  "version": "1.1.7",
  "main": "electron/main.cjs",
  "files": [
    "dist",
    "electron/main.cjs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "publish:check": "npm pack --dry-run --json",
    "prepack": "npm run build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "android:build": "node scripts/build-android.cjs",
    "desktop:package": "node scripts/repair-electron-install.cjs && electron-builder --win nsis --config.electronDist=node_modules/electron/dist",
    "webos:version-sync": "node scripts/sync-webos-version.cjs",
    "webos:sync": "node scripts/sync-webos-build.cjs",
    "webos:package": "npm run webos:version-sync && npm run build && npm run webos:sync && npx ares-package -n webos/",
    "build:all": "npm run build && npx cap sync android && npm run android:build && npm run webos:version-sync && npm run webos:sync && npx ares-package -n webos/ && npm run desktop:package",
    "postinstall": "node scripts/fix-webos-cli-rimraf.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "hls.js": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shaka-player": "^5.2.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@webos-tools/cli": "^3.2.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "webpack-cli": "^7.2.2"
  },
  "overrides": {
    "@webos-tools/cli": {
      "rimraf": "3.0.2"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "build": {
    "appId": "tv.toms.iptvmate.desktop",
    "productName": "Toms IPTVmate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Toms-IPTVmate-${version}-Setup.${ext}"
    }
  }
}
